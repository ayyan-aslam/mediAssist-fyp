# OPTIONAL agent-only overrides. Copy to agent/.env only if you want to change a default.
# Required secrets (OPENAI_API_KEY, MEDICINE_AI_DATABASE_URL) are read from the ROOT .env - nothing to add here.

# AGENT_LLM_MODEL=gpt-6-luna             # run: python -m mediassist_agent.models  to see what your key can use
# AGENT_LLM_TEMPERATURE=0                # kept low on purpose (deterministic extraction)
# AGENT_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_EMBEDDING_DIM=768                # must match VECTOR(768) in medicinedb
# AGENT_RAG_TABLE_PREFIX=agent           # tables: agent_medicine, agent_symptom_label, agent_medicine_symptom
# AGENT_RAG_MIN_SIMILARITY=0.60
# AGENT_RAG_MAX_MEDS_PER_SYMPTOM=3
# AGENT_MAX_RETRIES=2
# AGENT_INBOX_DIR=inbox
# AGENT_OUTBOX_DIR=outbox
# AGENT_DELETE_PROCESSED=false           # true = delete transcript after a successful run
# AGENT_POLL_SECONDS=3


