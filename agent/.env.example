# MediAssist agent settings. Copy this file to agent/.env - that is the ONE place the agent settings are set
# (the root .env holds only the shared secrets: OPENAI_API_KEY, MEDICINE_AI_DATABASE_URL, RABBITMQ_URL).
# AGENT_LLM_MODEL and AGENT_EMBEDDING_MODEL are required; the rest have defaults in config.py.

# Chat model used by every LLM step. See what your key can use: python -m mediassist_agent.models
AGENT_LLM_MODEL=gpt-4.1
# Kept at 0 on purpose (deterministic extraction).
AGENT_LLM_TEMPERATURE=0
AGENT_EMBEDDING_MODEL=text-embedding-3-small
# Must match VECTOR(768) in medicinedb.
AGENT_EMBEDDING_DIM=768

# RAG tables: agent_medicine, agent_symptom_label, agent_medicine_symptom
AGENT_RAG_TABLE_PREFIX=agent
AGENT_RAG_MIN_SIMILARITY=0.60
AGENT_RAG_MAX_MEDS_PER_SYMPTOM=3
AGENT_MAX_RETRIES=2

AGENT_INBOX_DIR=inbox
AGENT_OUTBOX_DIR=outbox
# true = delete the transcript after a successful run
AGENT_DELETE_PROCESSED=false
AGENT_POLL_SECONDS=3
