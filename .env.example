# MediAssist AI – environment settings
# Copy this file to .env and fill in the values. Never commit .env.
# The DB and RabbitMQ passwords below are for local Docker only.

# ---------------------------------------------------------------
# PostgreSQL (Docker)
# ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mediassist
POSTGRES_PORT=5432

# One login per service. Docker creates them on the first start (docker/postgres/init.sql).
# If you change a password after the first start, reset the volume (see README).
AUTH_DB_PASSWORD=change_me
DOCUMENT_DB_PASSWORD=change_me
CHAT_DB_PASSWORD=change_me
CONSULTATION_DB_PASSWORD=change_me
SOAP_WORKER_DB_PASSWORD=change_me
PRESCRIPTION_DB_PASSWORD=change_me
MEDICINE_AI_DB_PASSWORD=change_me
NOTIFICATION_DB_PASSWORD=change_me
AUDIT_DB_PASSWORD=change_me
AUDIT_OWNER_DB_PASSWORD=change_me

# ---------------------------------------------------------------
# Database URLs per service
# The password in each URL must match the password above.
# Node.js services (Prisma) select their schema with ?schema=.
# FastAPI services get their schema from the login's search_path.
# ---------------------------------------------------------------
AUTH_DATABASE_URL=postgresql://auth_service:change_me@localhost:5432/mediassist?schema=userdb
CONSULTATION_DATABASE_URL=postgresql://consultation_service:change_me@localhost:5432/mediassist?schema=consultationdb
PRESCRIPTION_DATABASE_URL=postgresql://prescription_service:change_me@localhost:5432/mediassist?schema=prescriptiondb
NOTIFICATION_DATABASE_URL=postgresql://notification_service:change_me@localhost:5432/mediassist?schema=notificationdb
# Audit Service at runtime: SELECT and INSERT only.
AUDIT_DATABASE_URL=postgresql://audit_service:change_me@localhost:5432/mediassist?schema=auditdb
# Audit Service migrations: owner of the AuditDB tables.
AUDIT_MIGRATION_DATABASE_URL=postgresql://audit_owner:change_me@localhost:5432/mediassist?schema=auditdb

DOCUMENT_DATABASE_URL=postgresql://document_service:change_me@localhost:5432/mediassist
CHAT_DATABASE_URL=postgresql://chat_service:change_me@localhost:5432/mediassist
SOAP_WORKER_DATABASE_URL=postgresql://soap_worker:change_me@localhost:5432/mediassist
MEDICINE_AI_DATABASE_URL=postgresql://medicine_ai_service:change_me@localhost:5432/mediassist

# ---------------------------------------------------------------
# RabbitMQ (Docker)
# ---------------------------------------------------------------
RABBITMQ_USER=mediassist
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://mediassist:change_me@localhost:5672

# ---------------------------------------------------------------
# Node.js services
# LOG_LEVEL: fatal, error, warn, info, debug, trace or silent.
# ---------------------------------------------------------------
LOG_LEVEL=info
AUTH_SERVICE_PORT=3001

# ---------------------------------------------------------------
# API Gateway
# GATEWAY_PORT: the only address the apps call (default 8080).
# FRONTEND_URL: the web app address, allowed by CORS.
# AUTH_SERVICE_URL: must match AUTH_SERVICE_PORT above.
# ---------------------------------------------------------------
GATEWAY_PORT=8080
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3001

# ---------------------------------------------------------------
# Access token (JWT)
# A long random value (at least 32 characters). Generate one with the command in the README.
# ---------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------
# CNIC protection (Auth & User Service)
# CNIC_ENCRYPTION_KEY: AES-256 key, 32 random bytes in base64 (cnic_encrypted column).
# CNIC_HASH_KEY: secret key for the CNIC hash, 32 random bytes in base64 (cnic_hash column).
# ---------------------------------------------------------------
CNIC_ENCRYPTION_KEY=
CNIC_HASH_KEY=

# ---------------------------------------------------------------
# Firebase Authentication (Admin SDK)
# Keep the service account JSON file in the secrets/ folder. It is ignored by Git.
# A relative path is read from the repo root.
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ---------------------------------------------------------------
# Amazon S3
# ---------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ---------------------------------------------------------------
# OpenAI (transcription, LLM tasks and embeddings)
# ---------------------------------------------------------------
OPENAI_API_KEY=
