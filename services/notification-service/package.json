{
  "name": "@mediassist/notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "dev": "node --watch --env-file-if-exists=../../.env src/server.js",
    "test": "vitest run",
    "reminders:send": "node --env-file-if-exists=../../.env scripts/send-due-reminders.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@mediassist/common": "^0.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
