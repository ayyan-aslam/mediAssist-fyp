# MediAssist AI – web app settings
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# These values are public: they are built into the browser code. Put no secrets here.

# Where the browser sends API calls. /api/v1 (recommended): the web app passes them on to
# GATEWAY_URL (see next.config.ts), so a phone on the same Wi-Fi works too.
# A full URL (for example http://localhost:8080/api/v1) calls the gateway directly (needs CORS).
NEXT_PUBLIC_API_URL=/api/v1

# API Gateway address used by that pass-on, without /api/v1 (root .env: GATEWAY_PORT).
# Read by the Next.js server only. Changing it needs a restart of npm run dev.
GATEWAY_URL=http://localhost:8080

# true: answer every request with the example responses from design doc Section 5.2.
# No backend and no Firebase keys are needed.
NEXT_PUBLIC_USE_MOCKS=false

# Firebase client keys (Firebase console > Project settings > Your apps > Web app).
# Required when NEXT_PUBLIC_USE_MOCKS is false.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
