# MediAssist AI – web app settings
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# These values are public: they are built into the browser code. Put no secrets here.

# API Gateway address, with the /api/v1 prefix (root .env: GATEWAY_PORT).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# true: answer every request with the example responses from design doc Section 5.2.
# No backend and no Firebase keys are needed.
NEXT_PUBLIC_USE_MOCKS=false

# Firebase client keys (Firebase console > Project settings > Your apps > Web app).
# Required when NEXT_PUBLIC_USE_MOCKS is false.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
