{
  "name": "mediassist-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "gateway",
    "services/auth-service",
    "services/consultation-service",
    "services/prescription-service",
    "services/notification-service",
    "services/audit-service",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --names gateway,auth,consultation --prefix-colors cyan,magenta,green \"npm run dev -w gateway\" \"npm run dev -w services/auth-service\" \"npm run dev -w services/consultation-service\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
