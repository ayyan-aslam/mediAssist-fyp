{
  "name": "mediassist-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "gateway",
    "services/auth-service",
    "services/consultation-service",
    "services/prescription-service",
    "services/notification-service",
    "services/audit-service",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --names gateway,auth,consultation,prescription,notification --prefix-colors cyan,magenta,green,yellow,blue \"npm run dev -w gateway\" \"npm run dev -w services/auth-service\" \"npm run dev -w services/consultation-service\" \"npm run dev -w services/prescription-service\" \"npm run dev -w services/notification-service\"",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
